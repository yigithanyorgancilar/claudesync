<Window x:Class="ClaudeSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClaudeSync"
        Title="ClaudeSync" Width="1060" Height="700" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" Icon="/Assets/ClaudeSync.ico"
        Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" UseLayoutRounding="True">
  <Window.Resources>
    <Storyboard x:Key="Spin" RepeatBehavior="Forever">
      <DoubleAnimation Storyboard.TargetName="SyncIconRotation" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1.1" />
    </Storyboard>
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,10,0,4" />
    </Style>
  </Window.Resources>

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Margin="24,18,24,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Image Source="/Assets/ClaudeSync.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="ClaudeSync" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{x:Static local:L.Tagline}" Style="{StaticResource Muted}" FontSize="12" />
        </StackPanel>
      </StackPanel>
      <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="AccountButton" Style="{StaticResource SubtleButton}" Click="Account_Click" Padding="10,6" Margin="0,0,6,0" ToolTip="{x:Static local:L.Account}">
          <StackPanel Orientation="Horizontal">
            <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentFillColorDefaultBrush}">
              <TextBlock x:Name="AccountInitial" Text="?" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="10,0,4,0" VerticalAlignment="Center">
              <TextBlock x:Name="AccountName" FontSize="13" FontWeight="SemiBold" />
              <TextBlock x:Name="DeviceName" Style="{StaticResource Muted}" FontSize="11" />
            </StackPanel>
            <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10" Margin="4,0,0,0" />
          </StackPanel>
        </Button>
        <Button x:Name="SyncButton" Click="Sync_Click" Padding="12,6" Margin="0,0,8,0" ToolTip="{x:Static local:L.SyncAllTooltip}">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="SyncIcon" Style="{StaticResource Icon}" Text="&#xE895;" RenderTransformOrigin="0.5,0.5">
              <TextBlock.RenderTransform><RotateTransform x:Name="SyncIconRotation" /></TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock x:Name="SyncButtonText" Text="{x:Static local:L.SyncNow}" Margin="8,0,0,0" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource PrimaryButton}" Click="Add_Click">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14" />
            <TextBlock Text="{x:Static local:L.AddConversation}" Margin="8,0,0,0" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Banner -->
    <Border x:Name="Banner" Grid.Row="1" Margin="24,10,24,0" Padding="16,12" Style="{StaticResource ToneCard}" Visibility="Collapsed">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Glyph}" Style="{StaticResource ToneForeground}" FontSize="20" Margin="0,0,14,0" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding StatusTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Muted}" FontSize="13" Margin="0,2,0,0" />
        </StackPanel>
        <Button x:Name="BannerAction" Grid.Column="2" Style="{StaticResource PrimaryButton}" Margin="16,0,0,0" VerticalAlignment="Center" Click="BannerAction_Click" />
      </Grid>
    </Border>

    <!-- Library -->
    <Grid x:Name="Library" Grid.Row="2" Margin="24,14,24,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="340" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource Card}" Padding="0">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="12,12,12,6">
            <TextBox x:Name="Search" TextChanged="Search_TextChanged" Padding="34,6,10,6" />
            <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Margin="12,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBlock x:Name="SearchHint" Text="{x:Static local:L.SearchConversations}" Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
          </Grid>
          <ListBox x:Name="Conversations" Background="Transparent" BorderThickness="0" Padding="6,0,6,6"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Conversations_SelectionChanged">
            <ListBox.GroupStyle>
              <GroupStyle>
                <GroupStyle.HeaderTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionHeader}" Margin="10,14,0,6" />
                  </DataTemplate>
                </GroupStyle.HeaderTemplate>
              </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem" BasedOn="{StaticResource DefaultListBoxItemStyle}">
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="MinHeight" Value="0" />
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type local:ConversationItem}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Glyph}" Style="{StaticResource ToneForeground}" Margin="0,1,12,0" VerticalAlignment="Top" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Detail -->
      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="14,0,0,0">
        <Grid>
          <StackPanel x:Name="EmptyDetail" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380" Margin="24">
            <TextBlock x:Name="EmptyGlyph" Style="{StaticResource Icon}" Text="&#xE8BD;" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBlock x:Name="EmptyTitle" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock x:Name="EmptyText" Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,6,0,0" />
            <Button x:Name="EmptyAction" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,18,0,0" Click="Add_Click" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14" />
                <TextBlock Text="{x:Static local:L.AddConversation}" Margin="8,0,0,0" />
              </StackPanel>
            </Button>
          </StackPanel>

          <ScrollViewer x:Name="Detail" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="28,24,28,24">
              <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding ProjectName}" Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </StackPanel>

              <!-- Status -->
              <Border Style="{StaticResource ToneCard}" Margin="0,22,0,0" Padding="18,16">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource ToneForeground}" FontSize="22" VerticalAlignment="Top" Margin="0,1,14,0" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding StatusTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding StatusDetail}" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="20" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                  </Grid>
                  <WrapPanel Margin="36,14,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Click="Join_Click" Visibility="{Binding CanJoin, Converter={StaticResource Visible}}" Margin="0,0,8,0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="14" />
                        <TextBlock Text="{x:Static local:L.TakeToThisComputer}" Margin="8,0,0,0" />
                      </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Click="CloseClaude_Click" Visibility="{Binding IsPending, Converter={StaticResource Visible}}" Margin="0,0,8,0"
                            Content="{x:Static local:L.CloseClaudeAndApply}" />
                    <Button Style="{StaticResource PrimaryButton}" Click="KeepLocal_Click" Visibility="{Binding IsConflict, Converter={StaticResource Visible}}" Margin="0,0,8,0"
                            Content="{x:Static local:L.KeepThisComputer}" ToolTip="{x:Static local:L.KeepThisComputerTooltip}" />
                    <Button Click="TakeCloud_Click" Visibility="{Binding IsConflict, Converter={StaticResource Visible}}" Margin="0,0,8,0"
                            Content="{x:Static local:L.TakeCloud}" ToolTip="{x:Static local:L.TakeCloudTooltip}" />
                    <Button Style="{StaticResource PrimaryButton}" Click="ChooseFolder_Click" Visibility="{Binding NeedsFolder, Converter={StaticResource Visible}}" Margin="0,0,8,0"
                            Content="{x:Static local:L.ChooseFolder}" />
                  </WrapPanel>
                </StackPanel>
              </Border>

              <!-- Facts -->
              <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" MinWidth="170" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{x:Static local:L.LastSyncLabel}" Style="{StaticResource Muted}" Margin="0,0,16,10" />
                <TextBlock Grid.Column="1" Text="{Binding LastSync}" Margin="0,0,0,10" />
                <TextBlock Grid.Row="1" Text="{x:Static local:L.FolderLabel}" Style="{StaticResource Muted}" Margin="0,0,16,0" />
                <TextBlock x:Name="FolderText" Grid.Row="1" Grid.Column="1" Text="{Binding LocalPath, TargetNullValue={x:Static local:L.NotChosen}}" TextWrapping="Wrap" />
              </Grid>

              <Separator Margin="0,22,0,16" />
              <WrapPanel>
                <Button Click="SyncOne_Click" Margin="0,0,8,8" Visibility="{Binding IsLinked, Converter={StaticResource Visible}}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" FontSize="14" />
                    <TextBlock Text="{x:Static local:L.SyncNow}" Margin="8,0,0,0" />
                  </StackPanel>
                </Button>
                <Button Click="Backups_Click" Margin="0,0,8,8">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" FontSize="14" />
                    <TextBlock Text="{x:Static local:L.Backups}" Margin="8,0,0,0" />
                  </StackPanel>
                </Button>
                <Button Click="OpenFolder_Click" Margin="0,0,8,8" Visibility="{Binding HasFolder, Converter={StaticResource Visible}}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="14" />
                    <TextBlock Text="{x:Static local:L.OpenFolder}" Margin="8,0,0,0" />
                  </StackPanel>
                </Button>
                <Button Click="Remove_Click" Margin="0,0,8,8" Style="{StaticResource SubtleButton}" ToolTip="{x:Static local:L.RemoveFromSyncTooltip}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                    <TextBlock Text="{x:Static local:L.RemoveFromSync}" Margin="8,0,0,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                  </StackPanel>
                </Button>
              </WrapPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- First run: connect a server, then sign in -->
    <ScrollViewer x:Name="Welcome" Grid.Row="1" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
      <Grid Margin="24">
        <Border x:Name="ServerPanel" Style="{StaticResource Card}" Width="540" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="36,30">
          <StackPanel>
            <Image Source="/Assets/ClaudeSync.png" Width="48" Height="48" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="{x:Static local:L.ServerTitle}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0" />
            <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,8,0,0" LineHeight="21" Text="{x:Static local:L.ServerText}" />
            <Button Style="{StaticResource SubtleButton}" HorizontalAlignment="Center" Margin="0,8,0,0" Click="SetupGuide_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="13" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="{x:Static local:L.SetupGuide}" Margin="8,0,0,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
              </StackPanel>
            </Button>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static local:L.ConnectionCode}" Margin="0,14,0,4" />
            <TextBox x:Name="CodeBox" />
            <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" Text="{x:Static local:L.ConnectionCodeHint}" />
            <Grid Margin="0,16,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Separator VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Style="{StaticResource Muted}" FontSize="12" Margin="12,0" Text="{x:Static local:L.OrEnterValues}" />
              <Separator Grid.Column="2" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static local:L.SupabaseUrl}" />
            <TextBox x:Name="SupabaseBox" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static local:L.PublishableKey}" />
            <TextBox x:Name="KeyBox" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static local:L.WorkerUrl}" />
            <TextBox x:Name="WorkerBox" />
            <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,20,0,0" Padding="20,8" Content="{x:Static local:L.Connect}" Click="Connect_Click" />
          </StackPanel>
        </Border>

        <Border x:Name="SignInPanel" Style="{StaticResource Card}" Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="36,32">
          <StackPanel>
            <Image Source="/Assets/ClaudeSync.png" Width="56" Height="56" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="{x:Static local:L.Welcome}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0" />
            <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,10,0,0" LineHeight="21" Text="{x:Static local:L.WelcomeText}" />
            <Button x:Name="SignInButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,24,0,0" Padding="20,8" Click="SignIn_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE77B;" FontSize="14" />
                <TextBlock x:Name="SignInText" Text="{x:Static local:L.SignInWithGoogle}" Margin="8,0,0,0" />
              </StackPanel>
            </Button>
            <TextBlock Style="{StaticResource Muted}" FontSize="12" TextAlignment="Center" Margin="0,12,0,0" Text="{x:Static local:L.SignInHint}" />
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>

    <!-- Footer -->
    <Grid Grid.Row="3" Margin="24,10,24,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse x:Name="ClaudeDot" Width="8" Height="8" Fill="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
        <TextBlock x:Name="ClaudeState" Style="{StaticResource Muted}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
        <TextBlock Text="·" Style="{StaticResource Muted}" FontSize="12" Margin="10,0" VerticalAlignment="Center" />
        <TextBlock x:Name="FooterStatus" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Style="{StaticResource SubtleButton}" Click="Support_Click" Padding="10,4" ToolTip="{x:Static local:L.SupportTooltip}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xEB51;" FontSize="13" Foreground="#E0605E" />
            <TextBlock Text="{x:Static local:L.Support}" Margin="6,0,0,0" FontSize="13" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource SubtleButton}" Click="Log_Click" Padding="10,4" ToolTip="{x:Static local:L.LogTooltip}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE9F9;" FontSize="13" />
            <TextBlock Text="{x:Static local:L.Log}" Margin="6,0,0,0" FontSize="13" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource SubtleButton}" Click="Settings_Click" Padding="10,4">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="13" />
            <TextBlock Text="{x:Static local:L.Settings}" Margin="6,0,0,0" FontSize="13" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
