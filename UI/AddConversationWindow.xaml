<Window x:Class="ClaudeSync.AddConversationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClaudeSync"
        Style="{StaticResource Dialog}" WindowStartupLocation="CenterOwner" Title="{x:Static local:L.AddConversation}" Width="640" Height="600" MinWidth="520" MinHeight="420">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="24,22,24,0">
      <TextBlock Text="{x:Static local:L.AddConversation}" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                 Text="{x:Static local:L.AddText}" />
    </StackPanel>
    <Grid Grid.Row="1" Margin="24,16,24,10">
      <TextBox x:Name="Search" TextChanged="Search_TextChanged" Padding="34,6,10,6" />
      <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Margin="12,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"
                 Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
      <TextBlock x:Name="SearchHint" Text="{x:Static local:L.SearchTitleOrProject}" Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                 Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
    </Grid>
    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="24,0,24,0">
      <Grid>
        <ListBox x:Name="List" SelectionMode="Multiple" Background="Transparent" BorderThickness="0" Padding="6"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="List_SelectionChanged">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource DefaultListBoxItemStyle}">
              <Setter Property="Padding" Value="10,8" />
              <Setter Property="Margin" Value="0,1" />
              <Setter Property="MinHeight" Value="0" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border x:Name="Check" Width="20" Height="20" CornerRadius="4" BorderThickness="1" Margin="0,1,14,0" VerticalAlignment="Top"
                        BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}">
                  <TextBlock x:Name="Tick" Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="12" HorizontalAlignment="Center" Visibility="Hidden"
                             Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Folder}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                  <Setter TargetName="Check" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                  <Setter TargetName="Check" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                  <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="Empty" Style="{StaticResource Muted}" TextAlignment="Center" VerticalAlignment="Center" Margin="32" Visibility="Collapsed" />
      </Grid>
    </Border>
    <Border Grid.Row="3" Margin="0,18,0,0" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="24,16">
      <Grid>
        <TextBlock x:Name="Count" Style="{StaticResource Muted}" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="{x:Static local:L.Cancel}" MinWidth="96" IsCancel="True" />
          <Button x:Name="AddButton" Content="{x:Static local:L.Add}" MinWidth="96" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" IsDefault="True" IsEnabled="False" Click="Add_Click" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
