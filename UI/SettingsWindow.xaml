<Window x:Class="ClaudeSync.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClaudeSync"
        Style="{StaticResource Dialog}" WindowStartupLocation="CenterOwner" Title="{x:Static local:L.Settings}"
        Width="660" Height="720" MinWidth="540" MinHeight="440">
  <Window.Resources>
    <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,12,0,4" />
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,22,24,20">
        <TextBlock Text="{x:Static local:L.Settings}" FontSize="20" FontWeight="SemiBold" />

        <TextBlock Text="{x:Static local:L.General}" Style="{StaticResource SectionHeader}" Margin="0,20,0,8" />
        <Border Style="{StaticResource Card}" Padding="16,12">
          <StackPanel>
            <CheckBox x:Name="Startup" Content="{x:Static local:L.StartWithWindows}" />
            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="30,2,0,0" Text="{x:Static local:L.StartWithWindowsHint}" />
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Static local:L.Language}" VerticalAlignment="Center" Margin="0,0,16,0" />
              <ComboBox x:Name="LanguageBox" Grid.Column="1" />
              <TextBlock Grid.Column="2" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" Text="{x:Static local:L.LanguageRestart}" />
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Text="Claude Desktop" Style="{StaticResource SectionHeader}" Margin="0,20,0,8" />
        <Border Style="{StaticResource Card}" Padding="16,12">
          <StackPanel>
            <TextBlock x:Name="Detected" TextWrapping="Wrap" LineHeight="20" />
            <Expander Header="{x:Static local:L.ManualFolders}" Margin="0,10,0,0">
              <StackPanel Margin="0,4,0,4">
                <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="{x:Static local:L.ManualFoldersHint}" />
                <TextBlock Style="{StaticResource Label}" Text="{x:Static local:L.DesktopDataFolder}" />
                <TextBox x:Name="DesktopRoot" />
                <TextBlock Style="{StaticResource Label}" Text="{x:Static local:L.AccountFolder}" />
                <TextBox x:Name="AccountId" />
                <TextBlock Style="{StaticResource Label}" Text="{x:Static local:L.WorkspaceFolder}" />
                <TextBox x:Name="WorkspaceId" />
                <TextBlock Style="{StaticResource Label}" Text="{x:Static local:L.ProjectsFolder}" />
                <TextBox x:Name="ProjectsRoot" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </Border>

        <TextBlock Text="{x:Static local:L.Server}" Style="{StaticResource SectionHeader}" Margin="0,20,0,8" />
        <Border Style="{StaticResource Card}" Padding="16,12">
          <StackPanel>
            <Grid>
              <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="{x:Static local:L.CopyConnectionCode}" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" Text="{x:Static local:L.CopyConnectionCodeHint}" />
              </StackPanel>
              <Button x:Name="CopyCodeButton" Content="{x:Static local:L.CopyConnectionCode}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="CopyCode_Click" />
            </Grid>
            <Expander Header="{x:Static local:L.ServerAddresses}" Margin="0,12,0,0">
              <StackPanel Margin="0,4,0,4">
                <TextBlock Style="{StaticResource Label}" Text="{x:Static local:L.SupabaseUrl}" />
                <TextBox x:Name="SupabaseUrl" />
                <TextBlock Style="{StaticResource Label}" Text="{x:Static local:L.PublishableKey}" />
                <TextBox x:Name="PublishableKey" />
                <TextBlock Style="{StaticResource Label}" Text="{x:Static local:L.WorkerUrl}" />
                <TextBox x:Name="WorkerUrl" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </Border>

        <TextBlock Text="{x:Static local:L.ThisComputerSection}" Style="{StaticResource SectionHeader}" Margin="0,20,0,8" />
        <Border Style="{StaticResource Card}" Padding="16,12">
          <Grid>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="Device" FontWeight="SemiBold" />
              <TextBlock x:Name="DeviceId" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />
            </StackPanel>
            <Button Content="{x:Static local:L.OpenDataFolder}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OpenData_Click" />
          </Grid>
        </Border>

        <TextBlock Text="{x:Static local:L.About}" Style="{StaticResource SectionHeader}" Margin="0,20,0,8" />
        <Border Style="{StaticResource Card}" Padding="16,12">
          <Grid>
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock x:Name="Version" FontWeight="SemiBold" />
              <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" Text="{x:Static local:L.AboutText}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button Click="Source_Click" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE943;" FontSize="13" />
                  <TextBlock Text="{x:Static local:L.SourceCode}" Margin="8,0,0,0" />
                </StackPanel>
              </Button>
              <Button Click="Donate_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xEB51;" FontSize="13" Foreground="#E0605E" />
                  <TextBlock Text="{x:Static local:L.BuyMeACoffee}" Margin="8,0,0,0" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="24,16">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="{x:Static local:L.Cancel}" MinWidth="96" IsCancel="True" />
        <Button Content="{x:Static local:L.Save}" MinWidth="96" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
